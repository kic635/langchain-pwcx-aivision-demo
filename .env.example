# OpenAI-compatible real model, used by the Agent and the local extraction worker.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# For a private model gateway, optionally set SSL_CERT_FILE to its trusted CA file.

# AI Vision Agent Framework onboarding supplies these Langfuse-compatible write credentials.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development

POWERCONTEXT_LANGCHAIN_BASE_URL=http://127.0.0.1:18012
POWERCONTEXT_LANGCHAIN_TOKEN=
# Required only for a deliberately trusted, non-loopback HTTP Server (prefer HTTPS).
POWERCONTEXT_LANGCHAIN_ALLOW_INSECURE_HTTP=false
# Must match the local demo Server's enabled artifact processing family.
POWERCONTEXT_LANGCHAIN_CONTEXT_ASSEMBLY={"sections":[{"family":"topic-memory","limit":4}]}
DEMO_MEMORY_TIMEOUT=180

# Optional: print direct AI Vision trace links (these only control the displayed URLs).
DEMO_AIVISION_BASE_URL=
DEMO_AIVISION_SPACE_ID=
DEMO_AIVISION_AGENT_UUID=
